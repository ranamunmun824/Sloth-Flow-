# GEMINI_API_KEY: Required for hosted Gemma 4 AI API calls via @google/genai.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# DEVTO_API_KEY: DEV.to Forem API key for saving drafts and publishing articles.
# Obtained from DEV.to -> Settings -> Extensions -> DEV Community API Keys.
DEVTO_API_KEY=

# PUBLISHER_ACCESS_CODE: Secret access code protecting DEV.to draft and publish operations.
# Configure an arbitrary passphrase to prevent unauthorized API calls through your server.
PUBLISHER_ACCESS_CODE=

# APP_URL: The URL where this applet is hosted.
APP_URL=
